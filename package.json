{
  "name": "cherishfire",
  "version": "1.5.117",
  "description": "Local-first Expo habit tracker with multi-state completion, notes, reminders, and rich statistics.",
  "main": "expo-router/entry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanGranat/Cherishfire.git"
  },
  "bugs": {
    "url": "https://github.com/YanGranat/Cherishfire/issues"
  },
  "homepage": "https://github.com/YanGranat/Cherishfire#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo prebuild --clean --platform android --no-install && expo run:android",
    "ios": "expo prebuild --clean --platform ios --no-install && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check": "npm run lint && npm run typecheck && npm run audit:architecture && npm run audit:database-runtime && npm run audit:settings-mutations && npm run audit:settings-navigation && npm run audit:startup-lifecycle && npm run audit:startup-data && npm run audit:theme-rendering && npm run audit:about-dialog && npm run audit:habit-persistence && npm run audit:habit-record-identity && npm run audit:habit-cache && npm run audit:habit-day-rollback && npm run audit:habit-detail && npm run audit:notes-cache && npm run audit:persistence-commit-scheduler && npm run audit:scene-structure && npm run audit:interaction-coordinators && npm run audit:app-modal-lifecycle && npm run audit:i18n && npm run audit:colors && npm run audit:archive && npm run audit:schedule && npm run audit:streak && npm run audit:repeat-monthly-draft && npm run audit:repeat-interval-draft && npm run audit:date-picker-cache && npm run audit:current-local-date && npm run audit:data-transfer && npm run audit:export-compatibility && npm run audit:stats-progress && npm run audit:stats-reorder && npm run audit:reminders && npm run audit:bundle-size && npm run audit:home-interactions && npm run audit:settings-language-effects && npm run audit:safety",
    "release:check": "npm run check && npm run db:check && npm run doctor && npm run audit:deps",
    "build:apk:eas": "npx --yes eas-cli@23.0.0 build --platform android --profile preview",
    "build:aab:eas": "npx --yes eas-cli@23.0.0 build --platform android --profile production",
    "build:ios:eas": "npx --yes eas-cli@23.0.0 build --platform ios --profile production",
    "submit:android:eas": "npx --yes eas-cli@23.0.0 submit --platform android --profile production",
    "submit:ios:eas": "npx --yes eas-cli@23.0.0 submit --platform ios --profile production",
    "audit:deps": "tsx scripts/audit-production-dependencies.ts",
    "audit:deps:raw": "npm audit --omit=dev",
    "audit:architecture": "tsx scripts/audit-architecture-boundaries.ts",
    "audit:database-runtime": "tsx scripts/audit-database-runtime.ts",
    "audit:settings-mutations": "tsx scripts/audit-settings-mutation-coordinator.ts",
    "audit:settings-navigation": "tsx scripts/audit-settings-navigation.ts",
    "audit:startup-lifecycle": "tsx scripts/audit-startup-lifecycle.ts",
    "audit:startup-data": "tsx scripts/audit-startup-data.ts",
    "audit:theme-rendering": "tsx scripts/audit-theme-rendering.ts",
    "audit:about-dialog": "tsx scripts/audit-about-dialog.ts",
    "audit:habit-persistence": "tsx scripts/audit-habit-persistence.ts",
    "audit:habit-record-identity": "tsx scripts/audit-habit-record-identity.ts",
    "audit:habit-cache": "tsx scripts/audit-habit-cache-policy.ts",
    "audit:habit-day-rollback": "tsx scripts/audit-habit-day-rollback.ts",
    "audit:habit-detail": "tsx scripts/audit-habit-detail.ts",
    "audit:notes-cache": "tsx scripts/audit-notes-cache.ts",
    "audit:persistence-commit-scheduler": "tsx scripts/audit-persistence-commit-scheduler.ts",
    "audit:scene-structure": "tsx scripts/audit-habit-scene.ts",
    "audit:interaction-coordinators": "tsx scripts/audit-interaction-coordinators.ts",
    "audit:app-modal-lifecycle": "tsx scripts/audit-app-modal-lifecycle.ts",
    "audit:i18n": "tsx scripts/audit-i18n-locales.ts",
    "audit:colors": "tsx scripts/audit-custom-colors.ts",
    "audit:archive": "tsx scripts/audit-archive.ts",
    "audit:schedule": "tsx scripts/audit-schedule-history.ts",
    "audit:streak": "tsx scripts/audit-streak.ts",
    "audit:repeat-monthly-draft": "tsx scripts/audit-repeat-monthly-draft.ts",
    "audit:repeat-interval-draft": "tsx scripts/audit-repeat-interval-draft.ts",
    "audit:date-picker-cache": "tsx scripts/audit-date-picker-cache.ts",
    "audit:current-local-date": "tsx scripts/audit-current-local-date.ts",
    "audit:data-transfer": "tsx scripts/audit-data-transfer-coordinator.ts",
    "audit:export-compatibility": "tsx scripts/audit-export-compatibility.ts",
    "audit:stats-progress": "tsx scripts/audit-statistics-progress.ts",
    "audit:stats-reorder": "tsx scripts/audit-statistics-reorder.ts",
    "audit:reminders": "tsx scripts/audit-reminder-sync.ts",
    "audit:bundle-size": "tsx scripts/audit-bundle-size.ts",
    "audit:safety": "tsx scripts/audit-ux-safety.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "audit:home-interactions": "tsx scripts/audit-home-interactions.ts",
    "audit:settings-language-effects": "tsx scripts/audit-settings-language-effects.ts"
  },
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/portal": "^1.0.14",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.7.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "^5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.8.7",
    "nativewind": "^4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "react-native-worklets": "0.5.1",
    "@react-navigation/core": "7.22.1",
    "minimatch@8.0.0 - 8.0.5": "8.0.6",
    "brace-expansion@1.0.0 - 1.1.20": "1.1.21",
    "brace-expansion@2.0.0 - 2.1.6": "2.1.7",
    "brace-expansion@4.0.0 - 5.0.11": "5.0.12",
    "@expo/metro-config": {
      "postcss": "8.5.23"
    }
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.4",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  }
}
